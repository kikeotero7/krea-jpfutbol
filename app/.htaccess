# JP Fútbol · los nombres antiguos (con guion) llevan a los definitivos
RewriteEngine On
RewriteCond %{HTTP_HOST} ^jpfutbol-web\.kreadigitalstudio\.es$ [NC]
RewriteRule ^ https://jpfutbolweb.kreadigitalstudio.es%{REQUEST_URI} [R=301,L]
RewriteCond %{HTTP_HOST} ^jpfutbol-app\.kreadigitalstudio\.es$ [NC]
RewriteRule ^ https://jpfutbolapp.kreadigitalstudio.es%{REQUEST_URI} [R=301,L]

# Seguridad (20-11-2026, auditoría KREA puntos 13, 14 y 23): siempre https, cabeceras del navegador, sin listados
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
Options -Indexes
<FilesMatch "\.(md|json|txt|sql|bak|zip|log)$">
  Require all denied
</FilesMatch>
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always unset X-Powered-By
</IfModule>
